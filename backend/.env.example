# === Baza ===
DATABASE_URL=postgresql+psycopg2://kip_tarozi:parol@localhost:5432/kip_tarozi

# === Xavfsizlik ===
# openssl rand -hex 32 bilan generatsiya qiling
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
# Texnik topshiriqqa ko'ra sessiya muddati cheklanmagan — juda uzoq muddat qo'yilgan (~10 yil)
ACCESS_TOKEN_EXPIRE_MINUTES=5256000

# === Login blok qoidasi ===
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=5

# === Fayllar ===
# Suratlar, PDF/Excel hujjatlar shu papkaga yoziladi
STORAGE_PATH=C:/Kip_tarozi/storage

# === RS232 tarozi ===
# Indikator modeli aniqlangach shu qiymatlar sozlanadi
RS232_PORT=COM3
RS232_BAUDRATE=9600
RS232_BYTESIZE=8
RS232_PARITY=N
RS232_STOPBITS=1
RS232_TIMEOUT=1
# Qabul qilingan qatordan og'irlikni ajratib olish uchun regex (named group "vazn" majburiy)
RS232_REGEX=(?P<vazn>[+-]?\d+\.?\d*)\s*kg
RS232_RECONNECT_SECONDS=5

# === Stability-check ===
# Og'irlik shu muddat davomida shu tolerantlik ichida tursa "barqaror" deb hisoblanadi
STABILITY_SECONDS=3
STABILITY_TOLERANCE_KG=0.2

# === Anti-o'g'irlik nazorati ===
ANTI_OGIRLIK_THRESHOLD_KG=130
# Shu og'irlikdan pastga tushsa va hali saqlanmagan bo'lsa "yuk saqlanmadi" hodisasi
ANTI_OGIRLIK_PASTGA_TUSHISH_KG=10

# === Kip saqlashdagi biznes qoidalari ===
# Shu vaqt oynasi ichida, shu tolerantlikdagi og'irlik bilan qayta saqlansa ogohlantirish beriladi
DUPLIKAT_VAQT_OYNASI_SONIYA=15
DUPLIKAT_OGIRLIK_TOLERANSI_KG=0.5
# Operator sababsiz tezkor bekor qila oladigan muddat
BEKOR_QILISH_MUDDATI_SONIYA=30

# === Stansiya Agenti <-> Backend ichki aloqasi ===
# Bu agent qaysi stansiya ekanini bildiradi (backenddagi stansiyalar.id).
# Bitta stansiya bo'lsa 1. Yangi stansiya qo'shilganda har birining .env'ida
# boshqa-boshqa qiymat qo'yiladi.
STANSIYA_ID=1
# Agent backendga (masalan shubhali holat) murojaat qilganda shu kalitni yuboradi
AGENT_API_KEY=CHANGE_ME_AGENT_KEY
# Agent shu manzildagi backendga ulanadi (dev: localhost, prod: VPS manzili)
BACKEND_URL=http://localhost:8000
# Agentning mahalliy offline navbat bazasi (internet uzilganda kiplar shu yerga yoziladi)
AGENT_QUEUE_DB_PATH=./storage/agent_navbat.db
AGENT_SYNC_INTERVAL_SONIYA=15

# Agent shu oraliqda backendga "salomatmi" xabarini yuboradi (Dashboard shuni ko'rsatadi)
AGENT_HOLAT_YUBORISH_SONIYA=30
AGENT_HOLAT_ESKIRISH_SONIYA=90

# === Kamera ===
# IP kameraning HTTP snapshot (bitta JPEG qaytaradigan) manzili. Model aniqlangach sozlanadi.
CAMERA_SNAPSHOT_URL=

# IP kamera (Hikvision/ISAPI mos, Digest auth). Uchalasi to'ldirilganda kip
# saqlanganda backend avtomatik bitta surat oladi. Parolni bu yerga yozmang —
# haqiqiy qiymatlar faqat .env faylida.
KAMERA_IP=
KAMERA_LOGIN=
KAMERA_PAROL=

# === Kunlik Telegram hisoboti ===
VAQT_ZONASI=Asia/Tashkent
KUNLIK_HISOBOT_VAQTI=20:00

# === Brend ===
BRAND_COLOR=#0F6E56

# === Muhit ===
ENV=dev
